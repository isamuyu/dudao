# ===== 服务端 server/.env（本地开发默认值，可不建文件直接跑） =====
PORT=3000
# sqlite（本地开发，零依赖）或 postgres（docker）
DB_TYPE=sqlite
SQLITE_PATH=../data/dudao.db
PG_HOST=localhost
PG_PORT=5432
PG_USER=dudao
PG_PASSWORD=dudao123
PG_DB=dudao
JWT_SECRET=dev-secret
# local（本地磁盘 ../data/uploads）或 s3（MinIO）
STORAGE_DRIVER=local
UPLOAD_DIR=../data/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dudao-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# ===== 前端 web/.env（开发时经 vite proxy 转发 /api，无需配置） =====
# VITE_API_BASE=/api
